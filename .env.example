# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=iam
POSTGRES_PASSWORD=iam-password
POSTGRES_DB=iam_dev

DATABASE_URL=postgres://iam:iam-password@localhost:5432/iam_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development            # development | production
BIND_ADDR=0.0.0.0:8080

# ── Session / token lifetimes ─────────────────────────────────────────────────
SESSION_COOKIE_NAME=session_token
REFRESH_COOKIE_NAME=refresh_token
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_HOURS=168          # 7 days

# ── Public rate-limit (per path + IP) ────────────────────────────────────────
PUBLIC_RATE_LIMIT_MAX=60
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60

# ── Login failure lockout ─────────────────────────────────────────────────────
LOGIN_FAILURE_LIMIT=5          # per account
LOGIN_FAILURE_SOURCE_LIMIT=20  # per source IP
LOGIN_FAILURE_WINDOW_SECONDS=900

# ── OTP ───────────────────────────────────────────────────────────────────────
# OTP_CODE_PEPPER MUST be changed to a random secret before deploying to production.
# Changing this value invalidates all in-flight OTP codes.
OTP_CODE_PEPPER=dev-otp-pepper-change-me-in-production
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=300
OTP_CODE_TTL_SECONDS=600       # 10 minutes
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Proxy / CORS ──────────────────────────────────────────────────────────────
# Set TRUST_PROXY_HEADERS=true only when the API sits behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
TRUSTED_ORIGIN=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Web (Next.js) ─────────────────────────────────────────────────────────────
INTERNAL_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NODE_ENV=development
